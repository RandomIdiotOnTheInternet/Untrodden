[resource]
script = ExtResource("1_hur4e")
subject = "Hello?"
inbound_body = "I'm sorry to bother you. I'm just very lonely, and I heard from the paper that you dears keep your company free from those strange new email robots. My husband passed away 12 years ago, and I don't really know anyone else than him. I just wanted to talk to a human being for a moment. What's your name?"
decision = SubResource("Resource_q55j7")
