[sub_resource type="Resource" id="Resource_rajly"]
script = ExtResource("4_rmox7")
text = "[color=dark_gray]You remember something, long forgotten within the receses of your mind."
left_portrait = ExtResource("3_bg36n")
right_portrait = ExtResource("3_bg36n")
text_sound = ExtResource("5_bymwl")
horizontal_alignment = 1
metadata/_custom_type_script = "uid://c1irdit10ydy4"

[sub_resource type="Resource" id="Resource_31t18"]
script = ExtResource("4_rmox7")
text = "..g-get outa my way, l-lumphead."
text_sound = ExtResource("6_1q552")
horizontal_alignment = 2
metadata/_custom_type_script = "uid://c1irdit10ydy4"

[sub_resource type="Resource" id="Resource_vmm5v"]
script = ExtResource("4_rmox7")
text = "Get out, I said! L-l-leave... you're not worth a dime, you... thief."
horizontal_alignment = 2
metadata/_custom_type_script = "uid://c1irdit10ydy4"

[sub_resource type="Resource" id="Resource_cpb78"]
script = ExtResource("4_rmox7")
text = "[shake]I-I-I was just hungry, daddy![/shake] I'm sorry! What-"
text_sound = ExtResource("7_4v7yj")
waits = false
