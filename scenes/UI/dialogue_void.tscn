[sub_resource type="Resource" id="Resource_0qlct"]
script = ExtResource("4_rmox7")
text = "[color=dark_gray]*You hear a bottle crashing, and a high-pitched [/color][color=gray]scream[/color][color=dark_gray].*"
horizontal_alignment = 1
metadata/_custom_type_script = "uid://c1irdit10ydy4"

[sub_resource type="Resource" id="Resource_arj8e"]
script = ExtResource("4_rmox7")
text = "[color=dark_gray]You don't want to remember any more."
horizontal_alignment = 1
